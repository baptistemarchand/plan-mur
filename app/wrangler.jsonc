{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "plan-mur",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-01",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": { "enabled": true },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "plan-mur",
			// À remplacer par l'identifiant rendu par `wrangler d1 create plan-mur`.
			// Wrangler y écrit un identifiant local tant que la base distante
			// n'existe pas : ce diff local est attendu.
			"database_id": "REMPLACER_APRES_WRANGLER_D1_CREATE",
			"migrations_dir": "migrations"
		}
	]
}
